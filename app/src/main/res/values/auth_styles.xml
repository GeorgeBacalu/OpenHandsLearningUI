<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenHandsLearning.Authentication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/auth_accent</item>
        <item name="colorPrimaryVariant">@color/main_blue</item>
        <item name="colorSecondary">@color/auth_accent</item>
        <item name="colorError">@color/auth_error</item>
        <item name="colorControlActivated">@color/auth_accent</item>
        <item name="android:textColorPrimary">@color/auth_text</item>
        <item name="android:textColorSecondary">@color/auth_muted</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/auth_text</item>
        <item name="colorSurface">@color/auth_surface</item>
        <item name="android:fontFamily">@font/source_sans_pro_regular</item>
        <item name="android:windowBackground">@color/auth_background</item>
        <item name="android:statusBarColor">@color/auth_background</item>
        <item name="android:windowLightStatusBar">@bool/auth_light_system_bars</item>
        <item name="android:navigationBarColor">@color/auth_navigation_bar</item>
    </style>

    <style name="AuthTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/source_sans_pro_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/auth_text</item>
    </style>

    <style name="AuthSubtitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/auth_muted</item>
    </style>

    <style name="AuthInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/auth_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/auth_accent</item>
        <item name="helperTextTextColor">@color/auth_muted</item>
        <item name="android:textColorHint">@color/auth_muted</item>
        <item name="endIconTint">@color/auth_muted</item>
    </style>

    <style name="AuthDropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/auth_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/auth_accent</item>
        <item name="helperTextTextColor">@color/auth_muted</item>
        <item name="android:textColorHint">@color/auth_muted</item>
        <item name="endIconTint">@color/auth_muted</item>
    </style>

    <style name="AuthEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/auth_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

    <style name="AuthPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/source_sans_pro_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/auth_button_text</item>
        <item name="backgroundTint">@color/auth_button_background</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AuthLinkButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/source_sans_pro_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/auth_accent</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
