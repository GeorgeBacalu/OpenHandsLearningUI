<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:startColor="@color/brand_gradient_end" android:endColor="@color/brand_pressed" android:angle="315" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:startColor="@color/brand_focus" android:endColor="@color/brand_gradient_end" android:angle="315" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:startColor="@color/brand_gradient_start" android:endColor="@color/brand_gradient_end" android:angle="315" />
        </shape>
    </item>
</selector>
