<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brand_ripple_on_primary">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="@color/brand_gradient_start" android:endColor="@color/brand_gradient_end" />
            <stroke android:width="1dp" android:color="#60BFD3FF" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
</ripple>
