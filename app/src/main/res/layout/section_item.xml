<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sectionCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
    android:clickable="true" android:focusable="true"
    app:cardBackgroundColor="@color/home_surface" app:cardCornerRadius="24dp" app:cardElevation="0dp"
    app:strokeColor="@color/home_border" app:strokeWidth="1dp" app:rippleColor="@color/brand_ripple">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp" android:minHeight="172dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/sectionArtwork"
            android:layout_width="88dp" android:layout_height="112dp" android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/home_video_art" app:cardCornerRadius="18dp"
            app:cardElevation="0dp" app:strokeWidth="0dp" android:importantForAccessibility="noHideDescendants">
            <ImageView android:id="@+id/sectionImage"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="@null"
                tools:src="@drawable/video_section" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
            <TextView android:id="@+id/sectionName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/home_text" android:textSize="22sp" android:fontFamily="@font/source_sans_pro_bold"
                tools:text="Video" />
            <TextView android:id="@+id/sectionDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/home_muted" android:textSize="15sp"
                android:lineSpacingExtra="2dp" tools:text="Urmărește semne și expresii în videoclipuri." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
                <TextView android:id="@+id/sectionAction" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textColor="@color/home_video_accent" android:textSize="16sp"
                    android:fontFamily="@font/source_sans_pro_semibold" tools:text="Explorează" />
                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/sectionIcon"
                    android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="8dp"
                    android:contentDescription="@null" app:srcCompat="@drawable/ic_arrow" app:tint="@color/home_video_accent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
