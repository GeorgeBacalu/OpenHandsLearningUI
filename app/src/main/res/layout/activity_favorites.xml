<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <androidx.appcompat.widget.Toolbar android:id="@+id/favorites_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/header_title_favorites" app:titleTextColor="@color/home_text"
        app:navigationIcon="@drawable/ic_profile_back" app:navigationContentDescription="@string/profile_back" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/favorites_progress"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/favorites_accent" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="32dp">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/favorites_header_background" android:padding="22dp">
                <TextView android:id="@+id/favorite_header" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp" android:text="@string/favorites_headline"
                    android:textColor="@color/home_text" android:textSize="28sp" android:fontFamily="@font/source_sans_pro_bold"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/favorites_header_icon"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/favorites_header_icon"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp"
                    android:background="@drawable/favorites_heart_background" android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_favorite_filled" app:tint="@color/favorites_accent"
                    app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.Barrier android:id="@+id/favorites_header_bottom"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:barrierDirection="bottom" app:constraint_referenced_ids="favorite_header,favorites_header_icon" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/favorites_subtitle"
                    android:textColor="@color/home_muted" android:textSize="16sp" android:lineSpacingExtra="2dp"
                    app:layout_constraintTop_toBottomOf="@id/favorites_header_bottom" app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView android:id="@+id/search_bar_container"
                style="@style/Widget.OpenHandsLearning.CatalogSearch"
                android:layout_marginStart="0dp" android:layout_marginEnd="0dp" android:layout_marginTop="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:addStatesFromChildren="true">
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/search_bar"
                        style="@style/Widget.OpenHandsLearning.CatalogSearchInput"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="@string/favorites_search_hint" android:importantForAutofill="no" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/search_icon"
                        style="@style/Widget.OpenHandsLearning.CatalogSearchIcon"
                        android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_marginVertical="4dp" android:layout_marginEnd="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/favorites_count" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="4dp"
                android:textColor="@color/home_muted" android:textSize="14sp" android:fontFamily="@font/source_sans_pro_semibold"
                android:accessibilityLiveRegion="polite" />

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_view"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:clipToPadding="false" />
            <include android:id="@+id/favorites_empty" layout="@layout/no_favorites" android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/favorites_error"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:visibility="gone" app:cardCornerRadius="20dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/home_surface" app:strokeColor="@color/home_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="24dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/favorites_loading_error" android:textColor="@color/home_text" android:textSize="17sp"
                        android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/favorites_retry"
                        style="@style/AuthPrimaryButton" android:text="@string/auth_retry" android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
