<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="24dp">
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/noFavoritesImage"
        android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="12dp"
        android:padding="26dp" android:background="@drawable/favorites_heart_background"
        app:srcCompat="@drawable/ic_favorite_filled" app:tint="@color/favorites_accent" android:contentDescription="@null" />
    <TextView android:id="@+id/firstMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/first_message" android:gravity="center"
        android:textColor="@color/home_text" android:textSize="23sp" android:fontFamily="@font/source_sans_pro_bold" />
    <TextView android:id="@+id/secondMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="@string/second_message" android:gravity="center"
        android:textColor="@color/home_muted" android:textSize="16sp" android:lineSpacingExtra="3dp"
        android:fontFamily="@font/source_sans_pro" />
    <com.google.android.material.button.MaterialButton android:id="@+id/browseCollectionsButton"
        style="@style/AuthPrimaryButton" android:layout_marginTop="24dp" android:text="@string/browse_collections" />
</LinearLayout>
