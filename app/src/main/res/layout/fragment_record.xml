<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recordingContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/recordingButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_centerHorizontal="true">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/voiceRecordingButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/voice_record_button_background"
            android:drawableStart="@drawable/voice_record_mic_badge"
            android:drawablePadding="16dp"
            android:elevation="4dp"
            android:fontFamily="@font/source_sans_pro_semibold"
            android:gravity="center_vertical|start"
            android:letterSpacing="0"
            android:padding="16dp"
            android:text="@string/record_voice_message"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@null" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/outputContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/recordingButtonsContainer"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sign_result_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/sign_result_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans_pro_semibold"
                    android:letterSpacing="0.08"
                    android:text="@string/voice_transcript_label"
                    android:textColor="@color/sign_result_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/categoryNameCardText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:breakStrategy="balanced"
                    android:fontFamily="@font/source_sans_pro_semibold"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/sign_result_text"
                    android:textSize="20sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/sign_result_stroke"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans_pro_bold"
                    android:text="@string/voice_signs_heading"
                    android:textColor="@color/sign_result_text"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/source_sans_pro_regular"
                    android:text="@string/voice_signs_reading_hint"
                    android:textColor="@color/sign_result_muted"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/voiceToSignRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</RelativeLayout>
