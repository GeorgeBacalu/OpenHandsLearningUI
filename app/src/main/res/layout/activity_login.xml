<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <include layout="@layout/auth_brand" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/auth_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/auth_card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/AuthTitle"
                    android:text="@string/auth_login_title" />

                <TextView
                    style="@style/AuthSubtitle"
                    android:text="@string/auth_login_subtitle" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthInput"
                    android:hint="@string/account_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/login_email"
                        style="@style/AuthEditText"
                        android:inputType="textEmailAddress"
                        android:autofillHints="username" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthInput"
                    android:hint="@string/account_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/login_password"
                        style="@style/AuthEditText"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:saveEnabled="false"
                        android:imeOptions="actionDone" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/auth_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    android:padding="8dp" />

                <ProgressBar
                    android:id="@+id/auth_progress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:indeterminateTint="@color/main_blue"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_login"
                    style="@style/AuthPrimaryButton"
                    android:text="@string/login" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_registration"
            style="@style/AuthLinkButton"
            android:text="@string/need_account" />

    </LinearLayout>

</ScrollView>
