<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="15dp"
    style="@style/Widget.OpenHandsLearning.CatalogCard">

    <RelativeLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:background="@drawable/catalog_card_background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/collapsedRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <ImageView
                android:id="@+id/categoryImage"
                style="@style/Widget.OpenHandsLearning.CategoryCardImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/placeholder_image" />

            <TextView
                android:id="@+id/categoryName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/categoryImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/arrowButton"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="@string/placeholder_text"
                android:fontFamily="@font/source_sans_pro_semibold"
                android:textColor="@color/catalog_card_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/arrowButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:contentDescription="@string/open_list"
                android:backgroundTint="@color/catalog_card_accent"
                app:layout_constraintTop_toTopOf="@id/categoryName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/categoryName"
                android:background="@drawable/ic_arrow_down" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <RelativeLayout
            android:id="@+id/expendedRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/collapsedRelativeLayout"
            android:paddingHorizontal="10dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeFromFavoriteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/catalog_card_border"
                android:gravity="center|bottom|top"
                android:includeFontPadding="false"
                android:padding="7dp"
                android:text="@string/remove_from_favorites"
                android:textAllCaps="false"
                android:textColor="@color/auth_error"
                android:textSize="15sp" />

        </RelativeLayout>

    </RelativeLayout>


</com.google.android.material.card.MaterialCardView>
