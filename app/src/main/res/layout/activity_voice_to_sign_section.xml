<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".presentation.voice_to_sign_section.VoiceToSignSectionActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-35dp"
        android:paddingBottom="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="280dp">

            <com.project.ohl.presentation.S3ImageView
                android:id="@+id/sectionHeaderImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/section_header_image"
                android:scaleType="centerCrop"
                app:mediaName="voice_to_sign_section_header"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.project.ohl.presentation.S3ImageView
                android:id="@+id/sectionHeaderOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/section_header_overlay"
                android:scaleType="fitXY"
                app:mediaName="overlay"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/voice_header_badge"
                    android:fontFamily="@font/source_sans_pro_semibold"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/voice_header_eyebrow"
                    android:textColor="#F0F5FF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/videoSectionHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/source_sans_pro_black"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/header_title_voice_to_sign_section"
                    android:textColor="@color/white"
                    android:textSize="25sp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/voice_header_accent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/videoSectionHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/source_sans_pro_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/header_subtitle_voice_to_sign_section"
                    android:textColor="#F0F5FF"
                    android:textSize="17sp" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="16dp"
                    android:alpha="0.2"
                    android:importantForAccessibility="no"
                    android:src="@drawable/voice_header_wave" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <RelativeLayout
            android:id="@+id/pageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerSection">
            <include layout="@layout/fragment_record" />
        </RelativeLayout>

    </RelativeLayout>

</ScrollView>
