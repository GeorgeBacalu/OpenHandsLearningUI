<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.MainActivity"
    tools:openDrawer="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/navigation_action_bar" />

        <ScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@color/main_blue">

            <RelativeLayout
                android:id="@+id/homepageHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/main_blue"
                android:padding="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="65dp"
                    android:layout_marginTop="150dp"
                    android:backgroundTint="@color/translucent_dark_blue"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/decoration_rectangle1"
                        android:layout_width="50dp"
                        android:layout_height="60dp"
                        android:background="#00193498"
                        tools:ignore="SpeakableTextPresentCheck"
                        android:contentDescription="@string/rectangle" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="450dp"
                    android:backgroundTint="@color/translucent_dark_blue"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/decoration_rectangle2"
                        android:layout_width="50dp"
                        android:layout_height="60dp"
                        android:background="#00193498"
                        tools:ignore="SpeakableTextPresentCheck"
                        android:contentDescription="@string/rectangle" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="270dp"
                    android:layout_marginTop="140dp"
                    android:backgroundTint="@color/translucent_dark_blue"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/decoration_rectangle3"
                        android:layout_width="50dp"
                        android:layout_height="60dp"
                        android:background="#00193498"
                        tools:ignore="SpeakableTextPresentCheck"
                        android:contentDescription="@string/rectangle" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="230dp"
                    android:layout_marginTop="430dp"
                    android:backgroundTint="@color/translucent_dark_blue"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/decoration_rectangle4"
                        android:layout_width="50dp"
                        android:layout_height="60dp"
                        android:background="#00193498"
                        tools:ignore="SpeakableTextPresentCheck"
                        android:contentDescription="@string/rectangle" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="250dp"
                    android:layout_marginTop="410dp"
                    android:backgroundTint="@color/translucent_dark_blue"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/decoration_rectangle5"
                        android:layout_width="50dp"
                        android:layout_height="60dp"
                        android:background="#00193498"
                        tools:ignore="SpeakableTextPresentCheck"
                        android:contentDescription="@string/rectangle" />

                </androidx.cardview.widget.CardView>







                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/openhandslearningLogo"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/openhandslearning_logo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="@string/app_logo" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <RelativeLayout
                    android:id="@+id/headerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/logo">

                    <TextView
                        android:id="@+id/welcomeMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/source_sans_pro_semibold"
                        android:text="@string/welcome_text"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/projectTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/welcomeMessage"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/source_sans_pro_black"
                        android:text="@string/project_name"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/projectDescription"
                        android:layout_width="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/projectTitle"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/source_sans_pro_semibold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/project_description"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                </RelativeLayout>




                <RelativeLayout
                    android:id="@+id/sectionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/headerText"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/sectionsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                   android:id="@+id/button_userNavigation"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_below="@id/sectionsContainer"
                   android:layout_marginTop="8dp"
                   android:minHeight="60dp"
                   android:text="Navigate to User" />

            </RelativeLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/navigation_header"
        app:menu="@menu/navigation_menu" />

</androidx.drawerlayout.widget.DrawerLayout>