<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">









    <PreferenceCategory app:title="Preferinte utilizator">

        <EditTextPreference
            app:key="signature"
            app:title="Numele tau"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="files"
            app:summary="Gestioneaza videoclipurile salvare"
            app:title="Fisierele mele" />

        <SwitchPreferenceCompat
            app:key="theme"
            app:summary="Alege intre modul luminos si cel intunecat in functie de preferintele tale"
            app:title="Tema aplicatie" />
        />

    </PreferenceCategory>

    <PreferenceCategory app:title="Preferinte aplicatie">
        <EditTextPreference
            app:key="reset"
            app:summary="Reseteaza setarile inapoi la configuratia initiala"
            app:title="Resetare preferinte" />

    </PreferenceCategory>

</PreferenceScreen>