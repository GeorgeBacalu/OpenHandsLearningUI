<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/user_preferences">

        <EditTextPreference
            app:key="signature"
            app:title="@string/your_name"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="files"
            app:summary="@string/my_files_summary"
            app:title="@string/my_files" />

        <SwitchPreferenceCompat
            app:key="theme"
            app:summary="@string/app_theme_summary"
            app:title="@string/app_theme" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/app_preferences">
        <EditTextPreference
            app:key="reset"
            app:summary="@string/reset_preferences_summary"
            app:title="@string/reset_preferences" />

    </PreferenceCategory>

    <Preference app:key="logout" app:title="@string/logout" app:summary="@string/logout_summary" />
</PreferenceScreen>
